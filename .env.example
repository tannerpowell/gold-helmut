# Copy to .env.local for local dev. In production, set these in Vercel
# (Project Settings -> Environment Variables).

# Stripe secret key (sk_live_... in production, sk_test_... locally).
# Dashboard -> Developers -> API keys. Read by lib/stripe.ts.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint pointed at /api/webhook
# (whsec_...). Created when you register the endpoint in
# Dashboard -> Developers -> Webhooks, listening for
# checkout.session.completed. For local testing use
# `stripe listen --forward-to localhost:3000/api/webhook`.
STRIPE_WEBHOOK_SECRET=

# Canonical site origin, no trailing slash (e.g. https://goldhelmetaward.com).
# Required in production: Stripe Checkout success/cancel redirects refuse to
# fall back to the request Host header there.
NEXT_PUBLIC_SITE_URL=

# Airtable credentials for the profile submission form (/api/profile-submission).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
